# ============================================
# 环境变量模板 —— 复制为 .env 后填入真实值
# docker-compose 会自动读取 .env 文件
# ============================================

# DashScope / 通义千问 API Key（必填）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# 搜索引擎 API Key（必填）
SEARCH_API_KEY=xxxxxxxxxxxxxxxx

# PostgreSQL 凭证
DB_USERNAME=aiagent
DB_PASSWORD=your_secure_password_here

# MCP Server（可选）
MCP_SERVER_URL=http://localhost:8127

# Ollama（可选，本地 LLM）
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:7b
