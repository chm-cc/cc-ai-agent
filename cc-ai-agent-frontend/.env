# 站点配置（复制为 .env 后按需修改）

# 站点基础信息
VITE_SITE_URL=https://example.com
VITE_SITE_NAME=AI Agent 应用中心
VITE_SITE_DESCRIPTION=AI Agent 应用中心，提供 AI 选车大师、AI 超级智能体等智能对话应用。
VITE_SITE_KEYWORDS=AI Agent,人工智能,智能对话,选车助手,超级智能体
VITE_SITE_AUTHOR=CC AI Agent Team
VITE_COPYRIGHT_HOLDER=CC AI Agent Team

# 备案号（如有，例如：京ICP备xxxxxxxx号）
VITE_ICP_NUMBER=

# Google Analytics 4 测量 ID（例如：G-XXXXXXXXXX）
VITE_GA_MEASUREMENT_ID=

# 百度统计 ID
VITE_BAIDU_ANALYTICS_ID=

# 自定义监控上报接口（接收错误、性能、页面访问等 JSON 数据）
VITE_MONITOR_API=
